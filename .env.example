# Copy to `.env.local`. Never commit real keys.

# Required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — OAuth / email redirects (falls back to VERCEL_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — Mock Interviewer (Vercel AI Gateway). On Vercel, OIDC is injected.
# AI_GATEWAY_API_KEY=

# Pro tier — only the string "true" enables monetization
NEXT_PUBLIC_ENABLE_MONETIZATION=false

# Pro only (server) — Stripe + service role for webhooks
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=
