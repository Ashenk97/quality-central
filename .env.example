# Copy this file to `.env.local` for local development.
# Never commit real keys. `.env*` is gitignored except this example.
#
# Vercel handoff: Project Settings → Environment Variables
# Add the two required keys for Production, Preview, and Development,
# then redeploy. NEXT_PUBLIC_* values are inlined at build time.

# Required. Supabase project URL (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Required. Supabase anon (public) key (Project Settings → API).
# Safe to expose in the browser; protect data with Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Canonical site origin for OAuth and email confirmation redirects.
# Example: https://quality-central.vercel.app
# If unset, the app falls back to VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
