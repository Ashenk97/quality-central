# Copy this file to `.env.local` for local development.
# Never commit real keys. `.env*` is gitignored except this example.
#
# Vercel handoff: Project Settings → Environment Variables
# Add the two required keys for Production, Preview, and Development,
# then redeploy. NEXT_PUBLIC_* values are inlined at build time.

# Required. Supabase project URL (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Required. Supabase anon (public) key (Project Settings → API).
# Safe to expose in the browser; protect data with Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Canonical site origin for OAuth and email confirmation redirects.
# Example: https://quality-central.vercel.app
# If unset, the app falls back to VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional locally. Mock Interviewer uses Vercel AI Gateway.
# On Vercel, OIDC is injected automatically after AI Gateway is enabled.
# Locally: create a key at vercel.com → AI Gateway → API Keys, then:
# AI_GATEWAY_API_KEY=

# Hidden Pro tier. Keep false until checkout, webhooks, and pricing are live.
# Only the string "true" turns monetization on.
NEXT_PUBLIC_ENABLE_MONETIZATION=false

# Server-only Stripe key. Prefer a restricted API key (rk_test_ / rk_live_)
# with Checkout Sessions + Customers permissions over a full secret key.
# Never commit real keys. Store the live key as a sensitive Vercel env var.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional. When set, createCheckoutSession only accepts this Price id.
# STRIPE_PRO_PRICE_ID=price_...
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks
# (or `stripe listen --forward-to localhost:3000/api/webhooks/stripe`).
# STRIPE_WEBHOOK_SECRET=whsec_...
# Service role key (Project Settings → API). Server-only. Required for the
# webhook to set is_pro_member. Never expose this in the browser.
# SUPABASE_SERVICE_ROLE_KEY=
